{
  "name": "@aztec-otc-desk/contracts",
  "devDependencies": {
    "@aztec/accounts": "catalog:",
    "@aztec/aztec.js": "catalog:",
    "@aztec/entrypoints": "catalog:",
    "@aztec/ethereum": "catalog:",
    "@aztec/noir-contracts.js": "catalog:",
    "@aztec/stdlib": "catalog:",
    "@aztec/test-wallet": "3.0.0-nightly.20250923",
    "@jest/globals": "^30.0.5",
    "@types/bun": "catalog:",
    "@types/jest": "catalog:",
    "jest": "^30.0.5"
  },
  "main": "./ts/src/index.ts",
  "types": "./ts/src/index.ts",
  "exports": {
    ".": "./ts/src/index.ts"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "scripts": {
    "postinstall": "bun run ./scripts/txe_token_artifact.ts",
    "test": "bun run test:nr && bun test",
    "test:nr": "aztec test",
    "deploy-tokens": "bun run ./scripts/deploy_tokens.ts",
    "compile": "aztec-nargo compile && aztec-postprocess-contract",
    "codegen": "aztec codegen target --outdir artifacts",
    "copy-artifacts": "bun run scripts/add_artifacts.ts",
    "build": "bun run compile && bun run codegen -f && bun run copy-artifacts",
    "sandbox": "VERSION=3.0.0-nightly.20250923 aztec start --sandbox",
    "pxe:local": "LOG_LEVEL=info VERSION=3.0.0-nightly.20250923 aztec start --pxe --pxe.nodeUrl http://localhost:8080 --pxe.proverEnabled false",
    "pxe:local:1": "bun run pxe:local --port 8081 --p2p.p2pPort 40401",
    "pxe:testnet": "VERSION=3.0.0-nightly.20250923 aztec start --pxe --pxe.nodeUrl=https://aztec-alpha-testnet-fullnode.zkv.xyz --l1-rpc-urls=https://eth-sepolia.public.blastapi.io --l1-chain-id 11155111",
    "pxe:testnet:1": "bun run pxe:testnet --port 8081 --p2p.p2pPort 40401"
  }
}